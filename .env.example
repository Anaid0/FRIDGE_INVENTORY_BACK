# --- Servidor ---
NODE_ENV=development
PORT=3000
# Orígenes permitidos (separados por coma): el front en desarrollo y la app Android (Capacitor).
CORS_ORIGIN=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost

# --- Base de datos (MySQL 8, ver docker-compose.yml) ---
# Puerto del host para el contenedor (3306 suele estar ocupado por un MySQL local)
MYSQL_PORT=3317
ADMINER_PORT=8080
DATABASE_URL="mysql://fridgeya:fridgeya@localhost:3317/fridgeya"
# Usada por los tests e2e
DATABASE_URL_TEST="mysql://fridgeya:fridgeya@localhost:3317/fridgeya_test"

# --- Autenticación ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Admin inicial (seed) ---
ADMIN_NAME=Admin
ADMIN_LASTNAME=FridgeYA
ADMIN_EMAIL=admin@fridgeya.local
ADMIN_PASSWORD=CambiaEstaClave123

# --- Compras ---
CURRENCY=COP
# Zona horaria de la oficina (cuándo empieza y termina cada día de una quincena)
APP_TIMEZONE=America/Bogota
UPLOADS_DIR=./uploads
# Costo de bcrypt (10 en producción; los tests e2e usan 4 para ir rápido)
BCRYPT_ROUNDS=10

# --- Logs (fatal | error | warn | info | debug | trace | silent) ---
LOG_LEVEL=info
